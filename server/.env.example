# Aurora Music Server - Environment Variables

# LLM配置
LLM_PROVIDER=openai  # openai | claude | deepseek | gemini | disabled
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-haiku-20240307

# DeepSeek（OpenAI兼容接口，key在 https://platform.deepseek.com/api_keys 申请，需先充值）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Gemini（OpenAI兼容接口，key在 Google AI Studio 免费申请，免费额度）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 音乐API配置
# 网易云：项目内已封装，启动方式 npm run music-api（默认端口 3100）
NETEASE_MUSIC_API_URL=http://localhost:3100
# 可选：自己的网易云 MUSIC_U cookie，用于播放有权限的会员歌曲（不填则 VIP 歌曲为 30 秒试听）
NETEASE_COOKIE=

# QQ音乐API（可选，暂未接入）
QQ_MUSIC_API_URL=

# 天气API配置
# 使用 OpenWeatherMap: https://openweathermap.org/api
WEATHER_API_KEY=your_openweather_api_key_here
WEATHER_PROVIDER=openweather

# 服务器配置
PORT=3001
NODE_ENV=development
